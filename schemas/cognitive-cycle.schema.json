{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/cognitive-cycle.schema.json",
  "title": "Auditable cognitive cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "tenant_id",
    "brain_id",
    "correlation_id",
    "classification",
    "status",
    "steps",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "cycle_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{7,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "status": { "enum": ["completed", "abstained"] },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/step" }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "stage", "occurred_at", "input_ids", "output_ids", "evidence_ids"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "stage": {
          "enum": [
            "perceive",
            "attend",
            "retrieve",
            "broadcast",
            "simulate",
            "propose_action",
            "evaluate",
            "propose_consolidation",
            "abstain",
            "complete"
          ]
        },
        "occurred_at": { "type": "string", "format": "date-time" },
        "input_ids": { "$ref": "#/$defs/ids" },
        "output_ids": { "$ref": "#/$defs/ids" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    }
  }
}
