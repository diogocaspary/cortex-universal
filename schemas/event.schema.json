{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/event.schema.json",
  "title": "Immutable domain event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "tenant_id",
    "actor",
    "subject",
    "occurred_at",
    "observed_at",
    "correlation_id",
    "source",
    "payload_hash",
    "schema_version",
    "classification"
  ],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$" },
    "event_type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{2,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "actor": { "$ref": "#/$defs/reference" },
    "subject": { "$ref": "#/$defs/reference" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": ["string", "null"], "maxLength": 128 },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "payload_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "data": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
