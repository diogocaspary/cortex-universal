{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/consolidation-proposal.schema.json",
  "title": "Governed memory consolidation proposal request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tenant_id", "brain_id", "batch_size", "candidates"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{7,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "batch_size": { "type": "integer", "minimum": 1, "maximum": 100 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "recency",
        "surprise",
        "salience",
        "goal_relevance",
        "evidence_quality",
        "source_memory_ids",
        "classification",
        "observed_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recency": { "$ref": "#/$defs/unit" },
        "surprise": { "$ref": "#/$defs/unit" },
        "salience": { "$ref": "#/$defs/unit" },
        "goal_relevance": { "$ref": "#/$defs/unit" },
        "evidence_quality": { "$ref": "#/$defs/unit" },
        "source_memory_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
