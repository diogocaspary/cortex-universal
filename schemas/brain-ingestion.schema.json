{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/brain-ingestion.schema.json",
  "title": "Validated evidence projection for the embedded brain",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "projection"],
  "properties": {
    "envelope": {
      "$ref": "https://github.com/diogocaspary/cortex-universal/schemas/ingestion-envelope.schema.json"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500000 },
        "embedding": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "type": "number" }
        },
        "entities": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/entity" }
        },
        "relations": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/relation" }
        },
        "citations": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "contradicts": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 },
        "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 256 },
        "object": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
