{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/workforce-evaluation.schema.json",
  "title": "Evidence-based workforce agent evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "brain_id",
    "classification",
    "agent_id",
    "work_item_id",
    "evaluator_id",
    "quality",
    "correctness",
    "efficiency",
    "policy_compliance",
    "evidence_ids",
    "idempotency_key"
  ],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "work_item_id": { "type": "string", "pattern": "^work:[a-f0-9]{32}$" },
    "evaluator_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "quality": { "type": "number", "minimum": 0, "maximum": 1 },
    "correctness": { "type": "number", "minimum": 0, "maximum": 1 },
    "efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
    "policy_compliance": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "notes_reference": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 }
  }
}
