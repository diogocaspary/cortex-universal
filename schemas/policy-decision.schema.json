{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/policy-decision.schema.json",
  "title": "Deterministic policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "request_id",
    "action_key",
    "risk_level",
    "matched_rule",
    "policy_version",
    "policy_fingerprint",
    "reasons",
    "obligations",
    "verification_action"
  ],
  "properties": {
    "decision": { "enum": ["allow", "deny"] },
    "request_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{7,127}$" },
    "action_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
    "risk_level": {
      "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 5 }, { "type": "null" }]
    },
    "matched_rule": { "type": ["string", "null"], "maxLength": 128 },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policy_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "verification_action": { "type": ["string", "null"], "maxLength": 128 }
  }
}
