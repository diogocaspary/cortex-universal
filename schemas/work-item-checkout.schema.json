{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/work-item-checkout.schema.json",
  "title": "Atomic work-item checkout request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "brain_id", "classification", "agent_id", "lease_seconds"],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "lease_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
  }
}
