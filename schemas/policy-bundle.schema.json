{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/policy-bundle.schema.json",
  "title": "Deterministic policy bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_effect", "rules"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "default_effect": { "const": "deny" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effect", "roles", "actions", "classifications", "obligations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
          "effect": { "enum": ["allow", "deny"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
          },
          "classifications": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["public", "internal", "confidential", "restricted"] }
          },
          "obligations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
          }
        }
      }
    }
  }
}
