{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/workforce-cost-event.schema.json",
  "title": "Real metered workforce cost event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "brain_id",
    "classification",
    "agent_id",
    "goal_id",
    "work_item_id",
    "provider",
    "model",
    "input_tokens",
    "output_tokens",
    "cached_input_tokens",
    "cost_microusd",
    "measurement_status",
    "evidence_reference",
    "occurred_at",
    "idempotency_key"
  ],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "goal_id": { "type": "string", "pattern": "^goal:[a-f0-9]{32}$" },
    "work_item_id": { "type": "string", "pattern": "^work:[a-f0-9]{32}$" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "cached_input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "cost_microusd": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
    "measurement_status": { "enum": ["provider-reported", "subscription-allocated"] },
    "evidence_reference": { "type": "string", "format": "uri", "maxLength": 2048 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 }
  }
}
