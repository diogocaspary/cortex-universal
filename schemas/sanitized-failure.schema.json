{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/sanitized-failure.schema.json",
  "title": "Payload-free failure diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failure_id",
    "occurred_at",
    "operation",
    "status_code",
    "error_code",
    "error_fingerprint",
    "request_id",
    "trace_id",
    "correlation_id"
  ],
  "properties": {
    "failure_id": { "type": "string", "pattern": "^failure:[A-Za-z0-9-]{8,120}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "operation": { "type": "string", "minLength": 1, "maxLength": 256 },
    "status_code": { "type": "integer", "minimum": 400, "maximum": 599 },
    "error_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "error_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "request_id": { "type": "string", "minLength": 8, "maxLength": 256 },
    "trace_id": { "type": "string", "pattern": "^trace:[A-Za-z0-9_.:-]{8,248}$" },
    "correlation_id": { "type": "string", "minLength": 8, "maxLength": 256 }
  }
}
