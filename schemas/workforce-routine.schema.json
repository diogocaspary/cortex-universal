{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/workforce-routine.schema.json",
  "title": "Governed recurring workforce routine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "brain_id",
    "classification",
    "name",
    "goal_id",
    "assigned_agent_id",
    "interval_seconds",
    "next_run_at",
    "template",
    "idempotency_key"
  ],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "name": { "type": "string", "minLength": 3, "maxLength": 256 },
    "goal_id": { "type": "string", "pattern": "^goal:[a-f0-9]{32}$" },
    "assigned_agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "interval_seconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
    "next_run_at": { "type": "string", "format": "date-time" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "priority",
        "required_capabilities",
        "acceptance_criteria",
        "budget",
        "review_required"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 256 },
        "description": { "type": "string", "minLength": 8, "maxLength": 8192 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "required_capabilities": {
          "type": "array",
          "maxItems": 25,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "budget": { "$ref": "#/$defs/budget" },
        "review_required": { "type": "boolean" }
      }
    },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "verification_method", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "description": { "type": "string", "minLength": 3, "maxLength": 512 },
        "verification_method": { "enum": ["evidence", "test", "human-approval"] },
        "required": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_tokens", "max_cost_microusd", "max_duration_ms"],
      "properties": {
        "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "max_cost_microusd": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "max_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
      }
    }
  }
}
