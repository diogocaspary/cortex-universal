{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/action-registry.schema.json",
  "title": "Trusted action registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "actions"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://github.com/diogocaspary/cortex-universal/schemas/action.schema.json"
      }
    }
  }
}
