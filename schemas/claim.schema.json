{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/claim.schema.json",
  "title": "Operational claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "subject",
    "predicate",
    "object",
    "status",
    "source",
    "observed_at",
    "valid_from",
    "confidence",
    "classification",
    "version"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subject": { "$ref": "#/$defs/reference" },
    "predicate": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,255}$" },
    "object": {
      "oneOf": [
        { "$ref": "#/$defs/reference" },
        { "type": "string", "maxLength": 16384 },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "status": {
      "enum": ["proposed", "verified", "disputed", "expired", "rejected"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "system"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "system": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidence_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "version": { "type": "integer", "minimum": 1 },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
