{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/metacognitive-evaluation.schema.json",
  "title": "Metacognitive confidence calibration request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tenant_id", "brain_id", "bin_count", "samples"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{7,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "bin_count": { "type": "integer", "minimum": 2, "maximum": 20 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "confidence", "correct", "evidence_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "correct": { "type": "boolean" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    }
  }
}
