{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/attention-selection.schema.json",
  "title": "Bounded attention selection request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tenant_id", "brain_id", "capacity", "candidates"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{7,127}$" },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capacity": { "type": "integer", "minimum": 1, "maximum": 100 },
    "weights": { "$ref": "#/$defs/weights" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "goal_alignment", "novelty", "urgency", "uncertainty"],
      "properties": {
        "relevance": { "$ref": "#/$defs/unit" },
        "goal_alignment": { "$ref": "#/$defs/unit" },
        "novelty": { "$ref": "#/$defs/unit" },
        "urgency": { "$ref": "#/$defs/unit" },
        "uncertainty": { "$ref": "#/$defs/unit" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relevance",
        "goal_alignment",
        "novelty",
        "urgency",
        "uncertainty",
        "classification",
        "source_ids",
        "observed_at"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "relevance": { "$ref": "#/$defs/unit" },
        "goal_alignment": { "$ref": "#/$defs/unit" },
        "novelty": { "$ref": "#/$defs/unit" },
        "urgency": { "$ref": "#/$defs/unit" },
        "uncertainty": { "$ref": "#/$defs/unit" },
        "classification": { "$ref": "#/$defs/classification" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
