{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diogocaspary/cortex-universal/schemas/work-item.schema.json",
  "title": "Governed work-item creation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "brain_id",
    "classification",
    "goal_id",
    "title",
    "description",
    "priority",
    "assigned_agent_id",
    "required_capabilities",
    "acceptance_criteria",
    "blocked_by",
    "budget",
    "review_required",
    "idempotency_key"
  ],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "brain_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "goal_id": { "type": "string", "pattern": "^goal:[a-f0-9]{32}$" },
    "parent_work_item_id": { "type": ["string", "null"], "pattern": "^work:[a-f0-9]{32}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 256 },
    "description": { "type": "string", "minLength": 8, "maxLength": 8192 },
    "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
    "assigned_agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "required_capabilities": {
      "type": "array",
      "maxItems": 25,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "blocked_by": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^work:[a-f0-9]{32}$" }
    },
    "budget": { "$ref": "#/$defs/budget" },
    "review_required": { "type": "boolean" },
    "source": { "enum": ["human", "agent-proposal"] },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "verification_method", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "description": { "type": "string", "minLength": 3, "maxLength": 512 },
        "verification_method": { "enum": ["evidence", "test", "human-approval"] },
        "required": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_total_tokens", "max_cost_microusd", "max_duration_ms"],
      "properties": {
        "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "max_cost_microusd": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "max_duration_ms": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
      }
    }
  }
}
