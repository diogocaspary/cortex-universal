@prefix cubo: <https://github.com/diogocaspary/cortex-universal/ontology/core#> .
@prefix integration: <https://github.com/diogocaspary/cortex-universal/ontology/integration#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/diogocaspary/cortex-universal/ontology/integration>
    a owl:Ontology ;
    owl:imports <https://github.com/diogocaspary/cortex-universal/ontology/core> ;
    owl:versionInfo "0.1.0" .

integration:System a owl:Class ; rdfs:subClassOf cubo:Agent .
integration:API a owl:Class ; rdfs:subClassOf cubo:Resource .
integration:Endpoint a owl:Class ; rdfs:subClassOf cubo:Resource .
integration:CredentialReference a owl:Class ; rdfs:subClassOf cubo:Resource .
integration:Connector a owl:Class ; rdfs:subClassOf cubo:Resource .
integration:SyncJob a owl:Class ; rdfs:subClassOf cubo:Activity .
integration:Mapping a owl:Class ; rdfs:subClassOf cubo:Resource .

integration:exposesAPI a owl:ObjectProperty ; rdfs:domain integration:System ; rdfs:range integration:API .
integration:hasEndpoint a owl:ObjectProperty ; rdfs:domain integration:API ; rdfs:range integration:Endpoint .
integration:usesCredentialReference a owl:ObjectProperty ; rdfs:range integration:CredentialReference .
integration:usesMapping a owl:ObjectProperty ; rdfs:domain integration:SyncJob ; rdfs:range integration:Mapping .
integration:provider a owl:DatatypeProperty ; rdfs:range xsd:string .
integration:secretReference a owl:DatatypeProperty ; rdfs:domain integration:CredentialReference ; rdfs:range xsd:string .
integration:endpointTemplate a owl:DatatypeProperty ; rdfs:domain integration:Endpoint ; rdfs:range xsd:string .
