@prefix cubo: <https://github.com/diogocaspary/cortex-universal/ontology/core#> .
@prefix agreement: <https://github.com/diogocaspary/cortex-universal/ontology/agreement#> .
@prefix party: <https://github.com/diogocaspary/cortex-universal/ontology/party#> .
@prefix workforce: <https://github.com/diogocaspary/cortex-universal/ontology/workforce#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/diogocaspary/cortex-universal/ontology/workforce>
    a owl:Ontology ;
    owl:imports <https://github.com/diogocaspary/cortex-universal/ontology/core>,
        <https://github.com/diogocaspary/cortex-universal/ontology/party>,
        <https://github.com/diogocaspary/cortex-universal/ontology/agreement> ;
    owl:versionInfo "0.1.0" .

workforce:Employment a owl:Class ; rdfs:subClassOf cubo:Relationship ; rdfs:label "Employment"@en .
workforce:WorkerRole a owl:Class ; rdfs:subClassOf cubo:Role ; rdfs:label "Worker role"@en .
workforce:Skill a owl:Class ; rdfs:subClassOf cubo:Concept ; rdfs:label "Skill"@en .
workforce:Competency a owl:Class ; rdfs:subClassOf cubo:Concept ; rdfs:label "Competency"@en .
workforce:Availability a owl:Class ; rdfs:subClassOf cubo:State ; rdfs:label "Availability"@en .
workforce:CompensationAgreement a owl:Class ; rdfs:subClassOf agreement:Agreement ; rdfs:label "Compensation agreement"@en .
workforce:LearningActivity a owl:Class ; rdfs:subClassOf cubo:Activity ; rdfs:label "Learning activity"@en .

workforce:worker a owl:ObjectProperty ; rdfs:domain workforce:Employment ; rdfs:range party:Person ; rdfs:label "worker"@en .
workforce:employer a owl:ObjectProperty ; rdfs:domain workforce:Employment ; rdfs:range party:Organization ; rdfs:label "employer"@en .
workforce:assignedRole a owl:ObjectProperty ; rdfs:domain workforce:Employment ; rdfs:range workforce:WorkerRole ; rdfs:label "assigned role"@en .
workforce:hasSkill a owl:ObjectProperty ; rdfs:domain cubo:Agent ; rdfs:range workforce:Skill ; rdfs:label "has skill"@en .
workforce:requiresSkill a owl:ObjectProperty ; rdfs:domain workforce:WorkerRole ; rdfs:range workforce:Skill ; rdfs:label "requires skill"@en .
workforce:proficiencyLevel a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "proficiency level"@en .
