{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "cubo": "https://github.com/diogocaspary/cortex-universal/ontology/core#",
    "party": "https://github.com/diogocaspary/cortex-universal/ontology/party#",
    "orgx": "https://github.com/diogocaspary/cortex-universal/ontology/organization#",
    "customer": "https://github.com/diogocaspary/cortex-universal/ontology/customer#",
    "offering": "https://github.com/diogocaspary/cortex-universal/ontology/offering#",
    "agreement": "https://github.com/diogocaspary/cortex-universal/ontology/agreement#",
    "commerce": "https://github.com/diogocaspary/cortex-universal/ontology/commerce#",
    "finance": "https://github.com/diogocaspary/cortex-universal/ontology/finance#",
    "process": "https://github.com/diogocaspary/cortex-universal/ontology/process#",
    "communication": "https://github.com/diogocaspary/cortex-universal/ontology/communication#",
    "knowledge": "https://github.com/diogocaspary/cortex-universal/ontology/knowledge#",
    "agent": "https://github.com/diogocaspary/cortex-universal/ontology/agent#",
    "policy": "https://github.com/diogocaspary/cortex-universal/ontology/policy#",
    "risk": "https://github.com/diogocaspary/cortex-universal/ontology/risk#",
    "metric": "https://github.com/diogocaspary/cortex-universal/ontology/metric#",
    "integration": "https://github.com/diogocaspary/cortex-universal/ontology/integration#",
    "tenant": "https://github.com/diogocaspary/cortex-universal/ontology/tenant#",
    "audit": "https://github.com/diogocaspary/cortex-universal/ontology/audit#",
    "identity": "https://github.com/diogocaspary/cortex-universal/ontology/identity-access#",
    "workforce": "https://github.com/diogocaspary/cortex-universal/ontology/workforce#",
    "project": "https://github.com/diogocaspary/cortex-universal/ontology/project#",
    "asset": "https://github.com/diogocaspary/cortex-universal/ontology/asset#",
    "supply": "https://github.com/diogocaspary/cortex-universal/ontology/supply-chain#",
    "service": "https://github.com/diogocaspary/cortex-universal/ontology/service-management#",
    "data": "https://github.com/diogocaspary/cortex-universal/ontology/data-governance#",
    "privacy": "https://github.com/diogocaspary/cortex-universal/ontology/privacy-compliance#",
    "memory": "https://github.com/diogocaspary/cortex-universal/ontology/memory#",
    "retrieval": "https://github.com/diogocaspary/cortex-universal/ontology/retrieval#",
    "cognition": "https://github.com/diogocaspary/cortex-universal/ontology/cognition#",
    "attention": "https://github.com/diogocaspary/cortex-universal/ontology/attention#",
    "world": "https://github.com/diogocaspary/cortex-universal/ontology/world-model#",
    "meta": "https://github.com/diogocaspary/cortex-universal/ontology/metacognition#",
    "learning": "https://github.com/diogocaspary/cortex-universal/ontology/learning#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "identifier": "cubo:identifier",
    "tenant": { "@id": "cubo:hasTenant", "@type": "@id" },
    "context": { "@id": "cubo:hasContext", "@type": "@id" },
    "state": { "@id": "cubo:hasState", "@type": "@id" },
    "about": { "@id": "cubo:about", "@type": "@id" },
    "source": { "@id": "cubo:derivedFrom", "@type": "@id" },
    "evidence": { "@id": "cubo:supportedBy", "@type": "@id", "@container": "@set" },
    "verificationStatus": { "@id": "cubo:hasVerificationStatus", "@type": "@vocab" },
    "classification": { "@id": "cubo:hasClassification", "@type": "@vocab" },
    "validFrom": { "@id": "cubo:validFrom", "@type": "xsd:dateTime" },
    "validUntil": { "@id": "cubo:validUntil", "@type": "xsd:dateTime" },
    "observedAt": { "@id": "cubo:observedAt", "@type": "xsd:dateTime" },
    "occurredAt": { "@id": "cubo:occurredAt", "@type": "xsd:dateTime" },
    "confidence": { "@id": "cubo:confidence", "@type": "xsd:decimal" },
    "riskLevel": { "@id": "cubo:riskLevel", "@type": "xsd:integer" },
    "correlationId": "cubo:correlationId",
    "causationId": "cubo:causationId",
    "payloadHash": "cubo:payloadHash",
    "recordsClaim": { "@id": "memory:recordsClaim", "@type": "@id" },
    "memorySpace": { "@id": "memory:belongsToMemorySpace", "@type": "@id" },
    "generatedFromEpisode": { "@id": "memory:generatedFromEpisode", "@type": "@id" },
    "hasMemoryStatus": { "@id": "memory:hasMemoryStatus", "@type": "@id" },
    "hasResult": { "@id": "retrieval:hasResult", "@type": "@id" },
    "usesChannel": { "@id": "retrieval:usesChannel", "@type": "@id" },
    "retrievalScore": "retrieval:retrievalScore",
    "gapAbout": { "@id": "cognition:gapAbout", "@type": "@id" },
    "gapCode": "cognition:gapCode",
    "hasCognitiveStep": { "@id": "cognition:hasCognitiveStep", "@type": "@id", "@container": "@set" },
    "hasCognitivePhase": { "@id": "cognition:hasCognitivePhase", "@type": "@id" },
    "selectedCandidate": { "@id": "attention:selectedCandidate", "@type": "@id", "@container": "@set" },
    "broadcastsContent": { "@id": "attention:broadcastsContent", "@type": "@id", "@container": "@set" },
    "predictsState": { "@id": "world:predictsState", "@type": "@id" },
    "comparesPrediction": { "@id": "world:comparesPrediction", "@type": "@id" },
    "normalizedError": { "@id": "world:normalizedError", "@type": "xsd:decimal" },
    "reportedConfidence": { "@id": "meta:reportedConfidence", "@type": "xsd:decimal" },
    "hasReplayCandidate": { "@id": "learning:hasReplayCandidate", "@type": "@id", "@container": "@set" },
    "reviewStatus": "learning:reviewStatus"
  }
}
