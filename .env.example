NODE_ENV=development
HOST=127.0.0.1
PORT=8080
CORTEX_API_TOKEN=
CORTEX_LOG_LEVEL=info
CORTEX_MAX_BODY_BYTES=1000000
CORTEX_MAX_RDF_QUADS=10000
CORTEX_RATE_LIMIT_MAX=120
CORTEX_DB_PATH=runtime/cortex.db
# Set only when using a migrated pgvector database; it replaces CORTEX_DB_PATH.
# CORTEX_DATABASE_URL=postgresql://cortex_runtime:password@127.0.0.1:5432/cortex?sslmode=require
CORTEX_AUDIT_HMAC_SECRET=
CORTEX_IDENTITY_MODE=static
# CORTEX_IDENTITY_HMAC_SECRET=
# CORTEX_STATIC_SUBJECT_ID=
# CORTEX_STATIC_TENANTS=
# CORTEX_STATIC_ROLES=
# CORTEX_STATIC_PERMISSIONS=
# CORTEX_STATIC_CLASSIFICATIONS=
CORTEX_AGENT_MAX_STEPS=32
CORTEX_AGENT_MAX_REPEATED_ACTION=3
CORTEX_ALLOWED_MCP_HOSTS=localhost,127.0.0.1,[::1]
